# Docker example (compose sets these automatically)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/autoservice

# Hosted PostgreSQL example
# DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require
SECRET_KEY=<replace-with-a-random-secret-key>
PORT=8000
SEED_DEMO_USERS=true
HTTPS_ONLY_COOKIE=false
# Optional: set both values to create the first admin when APP_USER is empty.
# Never use the demo account passwords for a public deployment.
# INITIAL_ADMIN_USERNAME=<your-admin-username>
# INITIAL_ADMIN_PASSWORD=<a-unique-strong-password>
